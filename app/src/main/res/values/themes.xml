<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme with AMOLED black background and edge-to-edge support -->
    <style name="Theme.MarsLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mars_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
